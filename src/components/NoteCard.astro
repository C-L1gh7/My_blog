---
interface Props {
  note: any;
  receiptId: string;
}

const { note, receiptId } = Astro.props;
const { Content } = await note.render();
const noteDate = new Date(note.data.date);
const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(noteDate);
const statusLabels = {
  todo: 'TODO',
  'in-progress': 'IN PROGRESS',
  done: 'COMPLETED',
  archived: 'ARCHIVED',
} as const;
const noteStatus = note.data.status as keyof typeof statusLabels;
const statusLabel = statusLabels[noteStatus];
---

<div
  class="receipt-stage"
  data-receipt-stage
  tabindex="0"
  aria-expanded="false"
  aria-label={`展开完整收据：${note.data.title}`}
>
  <article class="receipt-paper" data-receipt>
    <header class="receipt-header">
      <div>
        <p class="receipt-brand">C_L1GH7 / NOTE DEPT.</p>
        <p class="receipt-subtitle">Field note receipt</p>
      </div>
      <span class="receipt-type">Note</span>
    </header>

    <div class="receipt-row receipt-meta">
      <span>Issued</span>
      <time datetime={noteDate.toISOString()}>{formattedDate}</time>
    </div>

    <section class="receipt-section">
      <p class="receipt-label">Subject</p>
      <h2>{note.data.title}</h2>
    </section>

    <section class="receipt-section receipt-memo">
      <p class="receipt-label">Memo</p>
      <div class="note-body prose prose-sm max-w-none prose-headings:my-2 prose-p:my-0 prose-p:leading-7">
        <Content />
      </div>
    </section>

    <footer class="receipt-footer">
      {note.data.file && (
        <a href={note.data.file} target="_blank" rel="noopener noreferrer" class="receipt-row receipt-link">
          <span>Attachment</span>
          <span>Open file ↗</span>
        </a>
      )}

      <div class="receipt-total">
        <span>Status</span>
        <strong data-status={noteStatus}>{statusLabel}</strong>
      </div>

      <div class="receipt-barcode" role="img" aria-label={`Barcode ${receiptId}`}>*{receiptId}*</div>
      <p class="receipt-reference">C_L1GH7 · NOTE COPY · <strong>{receiptId}</strong> · {statusLabel}</p>
    </footer>
  </article>
</div>

<style>
  .receipt-stage {
    --paper: #fffdf5;
    position: relative;
    z-index: 0;
    height: 18rem;
    perspective: 900px;
    transform-style: preserve-3d;
    filter: drop-shadow(0 5px 3px rgb(26 26 26 / 0.12));
    transition: filter 280ms ease;
  }

  .receipt-stage:hover,
  .receipt-stage:focus-within,
  .receipt-stage.is-expanded {
    z-index: 20;
    filter: drop-shadow(0 15px 10px rgb(26 26 26 / 0.18));
  }

  .receipt-paper {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    min-height: 18rem;
    max-height: 18rem;
    flex-direction: column;
    padding: 1.5rem 1.35rem 2rem;
    border-top: 3px solid #1a1a1a;
    background: var(--paper);
    color: #1a1a1a;
    transform: rotateX(var(--receipt-rx, 0deg)) rotateY(var(--receipt-ry, 0deg)) translateY(var(--receipt-lift, 0px));
    transform-origin: center 35%;
    transform-style: preserve-3d;
    transition: max-height 520ms cubic-bezier(0.22, 1, 0.36, 1), transform 180ms ease-out, background-color 180ms ease;
    will-change: transform;
  }

  .receipt-paper::before,
  .receipt-paper::after {
    position: absolute;
    z-index: -1;
    left: 0;
    width: 100%;
    height: 8px;
    background:
      linear-gradient(135deg, var(--paper) 5px, transparent 0) 0 0 / 10px 8px repeat-x,
      linear-gradient(45deg, transparent 5px, var(--paper) 0) 0 0 / 10px 8px repeat-x;
    content: '';
  }

  .receipt-paper::before {
    top: -8px;
    transform: rotate(180deg);
  }

  .receipt-paper::after {
    bottom: -8px;
  }

  .receipt-stage:hover .receipt-paper,
  .receipt-stage:focus-within .receipt-paper,
  .receipt-stage.is-expanded .receipt-paper {
    --paper: #fffef9;
    --receipt-lift: -4px;
    max-height: 52rem;
  }

  .receipt-header,
  .receipt-row,
  .receipt-total {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .receipt-header {
    max-height: 1rem;
    padding-bottom: 0;
    overflow: hidden;
    border-bottom: 1px dashed transparent;
    transition: max-height 360ms ease, padding 360ms ease, border-color 360ms ease;
  }

  .receipt-header > div {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 360ms ease, opacity 220ms ease;
  }

  .receipt-stage:hover .receipt-header,
  .receipt-stage:focus-within .receipt-header,
  .receipt-stage.is-expanded .receipt-header {
    max-height: 4rem;
    padding-bottom: 1rem;
    border-bottom-color: rgb(26 26 26 / 0.5);
  }

  .receipt-stage:hover .receipt-header > div,
  .receipt-stage:focus-within .receipt-header > div,
  .receipt-stage.is-expanded .receipt-header > div {
    max-width: 13rem;
    opacity: 1;
  }

  .receipt-brand,
  .receipt-type,
  .receipt-row,
  .receipt-label,
  .receipt-reference {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .receipt-subtitle {
    margin-top: 0.15rem;
    color: #9ca3af;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
  }

  .receipt-type,
  .receipt-total strong {
    color: #dc2626;
  }

  .receipt-total strong[data-status='in-progress'] {
    color: #b45309;
  }

  .receipt-total strong[data-status='done'] {
    color: #15803d;
  }

  .receipt-total strong[data-status='archived'] {
    color: #6b7280;
  }

  .receipt-meta {
    max-height: 0;
    padding: 0;
    overflow: hidden;
    opacity: 0;
    color: #6b7280;
    font-variant-numeric: tabular-nums;
    transition: max-height 320ms ease, padding 320ms ease, opacity 220ms ease;
  }

  .receipt-stage:hover .receipt-meta,
  .receipt-stage:focus-within .receipt-meta,
  .receipt-stage.is-expanded .receipt-meta {
    max-height: 3rem;
    padding: 0.7rem 0;
    opacity: 1;
  }

  .receipt-section {
    padding: 0.75rem 0;
    border-top: 1px solid transparent;
    transition: padding 360ms ease, border-color 360ms ease;
  }

  .receipt-stage:hover .receipt-section,
  .receipt-stage:focus-within .receipt-section,
  .receipt-stage.is-expanded .receipt-section {
    padding: 1rem 0;
    border-top-color: rgb(26 26 26 / 0.12);
  }

  .receipt-label {
    max-height: 0;
    margin-bottom: 0;
    overflow: hidden;
    opacity: 0;
    color: #9ca3af;
    transition: max-height 260ms ease, margin 260ms ease, opacity 180ms ease;
  }

  .receipt-stage:hover .receipt-label,
  .receipt-stage:focus-within .receipt-label,
  .receipt-stage.is-expanded .receipt-label {
    max-height: 1rem;
    margin-bottom: 0.55rem;
    opacity: 1;
  }

  .receipt-section h2 {
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.4;
    cursor: text;
    user-select: text;
  }

  .receipt-memo {
    flex: 1;
    min-height: 0;
  }

  .note-body {
    position: relative;
    max-height: 8.75rem;
    overflow: hidden;
    color: #52525b;
    cursor: text;
    user-select: text;
    transition: max-height 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .receipt-stage:hover .note-body,
  .receipt-stage:focus-within .note-body,
  .receipt-stage.is-expanded .note-body {
    max-height: 24rem;
  }

  .note-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .receipt-footer {
    max-height: 0;
    padding-top: 0;
    overflow: hidden;
    opacity: 0;
    border-top: 1px dashed transparent;
    transition: max-height 420ms ease, padding 360ms ease, border-color 360ms ease, opacity 240ms ease 80ms;
  }

  .receipt-stage:hover .receipt-footer,
  .receipt-stage:focus-within .receipt-footer,
  .receipt-stage.is-expanded .receipt-footer {
    max-height: 16rem;
    padding-top: 0.9rem;
    opacity: 1;
    border-top-color: rgb(26 26 26 / 0.5);
  }

  .receipt-row {
    padding: 0.3rem 0;
    color: #6b7280;
  }

  .receipt-link {
    color: #1a1a1a;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .receipt-link:hover {
    color: #dc2626;
  }

  .receipt-link:focus-visible {
    outline: 2px solid #1a1a1a;
    outline-offset: 3px;
  }

  .receipt-total {
    margin-top: 0.75rem;
    padding: 0.65rem 0;
    border-top: 2px solid #1a1a1a;
    border-bottom: 2px solid #1a1a1a;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .receipt-barcode {
    width: 100%;
    height: 2.8rem;
    margin: 1rem auto 0.35rem;
    overflow: hidden;
    color: #1a1a1a;
    font-family: 'Libre Barcode 39', monospace;
    font-size: 3.5rem;
    font-weight: 400;
    line-height: 0.82;
    letter-spacing: 0;
    text-align: center;
    white-space: nowrap;
  }

  .receipt-reference {
    color: #9ca3af;
    text-align: center;
  }

  .receipt-reference strong {
    color: #1a1a1a;
  }

  @media (prefers-reduced-motion: reduce) {
    .receipt-stage,
    .receipt-paper {
      transition: none;
    }

    .receipt-stage:hover .receipt-paper,
    .receipt-stage:focus-within .receipt-paper,
    .receipt-stage.is-expanded .receipt-paper {
      --receipt-lift: 0px;
    }
  }
</style>

<script>
  const canTilt = window.matchMedia('(hover: hover) and (pointer: fine)').matches
    && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canTilt) {
    document.querySelectorAll<HTMLElement>('[data-receipt-stage]').forEach((stage) => {
      const receipt = stage.querySelector<HTMLElement>('[data-receipt]');
      if (!receipt) return;

      stage.addEventListener('pointermove', (event) => {
        if (stage.classList.contains('is-selecting')) return;
        const bounds = stage.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        receipt.style.setProperty('--receipt-rx', `${(-y * 4).toFixed(2)}deg`);
        receipt.style.setProperty('--receipt-ry', `${(x * 5).toFixed(2)}deg`);
      });

      stage.addEventListener('pointerleave', () => {
        receipt.style.setProperty('--receipt-rx', '0deg');
        receipt.style.setProperty('--receipt-ry', '0deg');
      });

      stage.addEventListener('pointerdown', (event) => {
        if (!(event.target as HTMLElement).closest('h2, .note-body')) return;
        stage.classList.add('is-selecting');
        receipt.style.setProperty('--receipt-rx', '0deg');
        receipt.style.setProperty('--receipt-ry', '0deg');
      });

      document.addEventListener('pointerup', () => stage.classList.remove('is-selecting'));
    });
  }

  const receiptStages = Array.from(document.querySelectorAll<HTMLElement>('[data-receipt-stage]'));

  receiptStages.forEach((stage) => {
    stage.addEventListener('focus', () => stage.setAttribute('aria-expanded', 'true'));
    stage.addEventListener('blur', () => {
      if (!stage.classList.contains('is-expanded')) stage.setAttribute('aria-expanded', 'false');
    });
    stage.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) return;
      if (window.getSelection()?.toString()) return;
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

      const shouldExpand = !stage.classList.contains('is-expanded');
      receiptStages.forEach((item) => {
        item.classList.remove('is-expanded');
        item.setAttribute('aria-expanded', 'false');
      });
      stage.classList.toggle('is-expanded', shouldExpand);
      stage.setAttribute('aria-expanded', String(shouldExpand));
    });
  });

  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('[data-receipt-stage]')) return;
    receiptStages.forEach((stage) => {
      stage.classList.remove('is-expanded');
      stage.setAttribute('aria-expanded', 'false');
    });
  });
</script>
