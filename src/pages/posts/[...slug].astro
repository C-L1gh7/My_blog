---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar';
import { getFirstContentImage } from '../../utils/seo';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const pageImage = post.data.image ?? getFirstContentImage(post.body);
const postUrl = new URL(Astro.url.pathname, Astro.site?.origin || 'https://www.cl1gh7.top').href;
const postJsonLd = {
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.excerpt || post.data.title,
    url: postUrl,
    mainEntityOfPage: postUrl,
    datePublished: post.data.date,
    dateModified: post.data.date,
    inLanguage: "zh-CN",
    author: { "@id": "https://www.cl1gh7.top/#person" },
    publisher: { "@id": "https://www.cl1gh7.top/#person" },
    ...(pageImage ? { image: new URL(pageImage, Astro.site?.origin || 'https://www.cl1gh7.top').href } : {}),
};
---

<BaseLayout
    title={post.data.title + ' — C_L1gh7'}
    description={post.data.excerpt || post.data.description || post.data.title}
    ogImage={pageImage}
    ogType="article"
    canonicalURL={postUrl}
    jsonLd={postJsonLd}
>
    <Navbar client:load />

    <div class="content-container pt-28 pb-20">
      <a href={`${import.meta.env.BASE_URL}posts/`} id="go-back" class="inline-block mb-8 font-mono text-xs font-bold hover:text-red-600 transition-colors">
        &larr; GO BACK
      </a>

      <script>
        const backLink = document.getElementById('go-back');
        if (backLink) {
            backLink.addEventListener('click', (e) => {
                // 如果有来源页面，且来源页面属于本站，则执行后退
                if (document.referrer && document.referrer.includes(window.location.host)) {
                    e.preventDefault();
                    window.history.back();
                }
            });
        }
      </script>

      <div class="bg-white md:border-2 md:border-black p-4 sm:p-6 md:p-12 md:shadow-[8px_8px_0px_#ccc]">
          <article class="prose prose-sm sm:prose-base md:prose-lg max-w-none mx-auto">
            <header class="mb-8 md:mb-12 border-b-2 border-black pb-6 md:pb-8">
                <div class="flex items-center gap-3 font-mono text-xs font-bold text-gray-500 mb-4">
                    <span class="text-black">{post.data.date}</span>
                    <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                    <span class="uppercase tracking-wider text-red-600">{post.data.tag || 'GENERAL'}</span>
                </div>
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold uppercase tracking-tight mb-6 leading-tight">{post.data.title}</h1>
                {post.data.image && (
                    <div class="w-full bg-gray-100 mt-6 md:mt-8 border-2 border-black overflow-hidden relative flex justify-center items-center">
                        <img
                            src={post.data.image}
                            alt={post.data.title}
                            class="max-w-full h-auto max-h-[600px] object-contain"
                        />
                    </div>
                )}
            </header>

            <div class="post-body font-sans leading-relaxed text-base md:text-lg text-gray-800">
                <Content />
            </div>
          </article>
      </div>
    </div>
</BaseLayout>

<style is:global>
  /* ── Overlay backdrop ── */
  .img-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(240, 240, 237, 0.78);
    backdrop-filter: blur(20px) saturate(0.82);
    -webkit-backdrop-filter: blur(20px) saturate(0.82);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .img-zoom-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* ── Stage (contains the image) ── */
  .img-zoom-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: none;
  }

  .img-zoom-stage img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    zoom: 1 !important;
    transform-origin: center;
    will-change: transform;
    border-radius: 4px;
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(0, 0, 0, 0.05);
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: auto;
  }

  .img-zoom-stage img.transitioning {
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* ── Zoom indicator badge ── */
  .img-zoom-badge {
    position: fixed;
    bottom: max(22px, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    z-index: 10002;
    min-width: 68px;
    background: rgba(240, 240, 237, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(26, 26, 26, 0.18);
    border-radius: 4px;
    padding: 7px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
    color: #1a1a1a;
    opacity: 1;
    pointer-events: none;
    letter-spacing: 0;
  }

  .img-zoom-close {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 10003;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(26, 26, 26, 0.2);
    border-radius: 4px;
    background: rgba(240, 240, 237, 0.9);
    color: #1a1a1a;
    font: 24px/1 Arial, sans-serif;
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: color 140ms ease, background 140ms ease;
  }

  .img-zoom-close:hover {
    background: #1a1a1a;
    color: #fff;
  }

  @media (max-width: 640px) {
    .img-zoom-close {
      top: max(12px, env(safe-area-inset-top));
      right: max(12px, env(safe-area-inset-right));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .img-zoom-overlay,
    .img-zoom-stage img,
    .img-zoom-close { transition: none; }
  }

  .post-body :where(p) {
    text-indent: 2em;
  }

  .post-body :where(li p, blockquote p, table p) {
    text-indent: 0;
  }

  .post-body :where(p:has(img), p:has(video), p:has(iframe)) {
    text-indent: 0;
  }
</style>

<script>
  // @ts-nocheck — browser-only vanilla JS, no TS types needed
  (function () {
    /* ================================================================
       Image Zoom Lightbox — scroll to zoom, drag to pan, dblclick toggle
       ================================================================ */
    const MARGIN = 0.85;
    const MIN_ZOOM = 0.5;
    const MAX_ZOOM = 10;
    const DBLCLICK_ZOOM = 2.5;

    /* --- DOM scaffolding --- */
    const overlay = document.createElement('div');
    overlay.className = 'img-zoom-overlay';
    overlay.innerHTML = `
      <div class="img-zoom-stage"></div>
      <div class="img-zoom-badge"></div>
      <button class="img-zoom-close" type="button" aria-label="关闭图片预览" title="关闭 (Esc)">×</button>
    `;
    document.body.appendChild(overlay);

    const stage     = overlay.querySelector('.img-zoom-stage');
    const img       = stage.appendChild(document.createElement('img'));
    const badge     = overlay.querySelector('.img-zoom-badge');
    const closeButton = overlay.querySelector('.img-zoom-close');

    /* --- State --- */
    let zoom      = 1;              // user-zoom multiplier (1 = fit-screen)
    let panX      = 0;             // px offset from centered position
    let panY      = 0;
    let baseScale = 1;             // scale that makes image fit 90vw/90vh
    let nw = 0, nh = 0;            // natural image dimensions
    let previousBodyOverflow = '';

    /* ================================================================
       Helpers
       ================================================================ */
    const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), hi);

    /** Layout-viewport dimensions (matches position:fixed overlay).
        visualViewport gets us the visible area dimensions on mobile. */
    function vpW() { return window.visualViewport?.width  ?? document.documentElement.clientWidth; }
    function vpH() { return window.visualViewport?.height ?? document.documentElement.clientHeight; }
    /** Offset of the visual viewport within the layout viewport
        (e.g. address bar pushes the visual area down on mobile). */
    function vpOffX() { return window.visualViewport?.offsetLeft ?? 0; }
    function vpOffY() { return window.visualViewport?.offsetTop  ?? 0; }
    /** Convert event clientX/Y (visual-viewport coords) to overlay coords */
    function toOverlayX(cx) { return cx + vpOffX(); }
    function toOverlayY(cy) { return cy + vpOffY(); }

    /** Total CSS scale = baseScale * zoom */
    function totalScale() { return baseScale * zoom; }

    /** Recompute baseScale from natural dims & viewport */
    function recalcBase() {
      if (!nw || !nh) return;
      baseScale = Math.min(
        (MARGIN * vpW())  / nw,
        (MARGIN * vpH()) / nh,
        1
      );
    }

    /** Apply current state to the DOM */
    function applyTransform(animate = false) {
      const ts = totalScale();
      img.classList.toggle('transitioning', animate);
      img.style.transform = `translate(-50%, -50%) translate(${panX}px, ${panY}px) scale(${ts})`;
    }

    /** Constrain pan so image edges never leave viewport edges */
    function clampPan() {
      if (zoom <= MIN_ZOOM) { panX = 0; panY = 0; return; }
      const ts  = totalScale();
      const rw  = nw * ts;
      const rh  = nh * ts;
      const maxX = Math.max(0, (rw - vpW())  / 2);
      const maxY = Math.max(0, (rh - vpH()) / 2);
      panX = clamp(panX, -maxX, maxX);
      panY = clamp(panY, -maxY, maxY);
    }

    /** Whether the image currently overflows the viewport (pannable) */
    function isOverflowing() {
      const ts = totalScale();
      return nw * ts > vpW() || nh * ts > vpH();
    }

    /** Set cursor based on whether image overflows viewport */
    function updateCursor() {
      if (isOverflowing()) {
        img.style.cursor = 'grab';
        overlay.style.cursor = 'default';
      } else {
        img.style.cursor = 'zoom-in';
        overlay.style.cursor = 'default';
      }
    }

    /** Keep the current zoom percentage visible while the viewer is open. */
    function showBadge() {
      const pct = Math.round(zoom * 100);
      badge.textContent = pct + '%';
    }

    /** Reset to fit-screen */
    function resetView(animate = false) {
      zoom = 1;
      panX = 0;
      panY = 0;
      clampPan();
      applyTransform(animate);
      updateCursor();
      showBadge();
    }

    /* ================================================================
       Open / Close
       ================================================================ */
    function open(src, alt) {
      img.src = src;
      img.alt = alt || '';

      function onLoad() {
        nw = img.naturalWidth;
        nh = img.naturalHeight;
        if (!nw || !nh) return;
        recalcBase();
        resetView(false);
        overlay.classList.add('active');
        onViewportChange();
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
      }

      if (img.complete && img.naturalWidth) {
        onLoad();
      } else {
        img.addEventListener('load', onLoad, { once: true });
      }
    }

    function close() {
      overlay.classList.remove('active');
      document.body.style.overflow = previousBodyOverflow;
      setTimeout(() => {
        if (!overlay.classList.contains('active')) img.src = '';
      }, 300);
    }

    /* ================================================================
       Wheel → zoom toward cursor
       ================================================================ */
    overlay.addEventListener('wheel', (e) => {
      if (!overlay.classList.contains('active')) return;
      e.preventDefault();

      const oldZoom = zoom;
      const normalizedDelta = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY;
      zoom = clamp(oldZoom * Math.exp(-normalizedDelta * 0.0015), MIN_ZOOM, MAX_ZOOM);
      if (zoom === oldZoom) return;

      // Keep the image center fixed; panning remains available after overflow.
      clampPan();
      applyTransform(false);
      updateCursor();
      showBadge();
    }, { passive: false });

    /* ================================================================
       Mouse drag → pan
       ================================================================ */
    let dragging = false;
    let justDragged = false;
    let dragSX = 0, dragSY = 0, panSX = 0, panSY = 0;

    img.addEventListener('mousedown', (e) => {
      if (!isOverflowing()) return;
      e.preventDefault();
      dragging = true;
      justDragged = false;
      dragSX = e.clientX; dragSY = e.clientY;
      panSX  = panX;       panSY  = panY;
      img.style.cursor = 'grabbing';
    });

    document.addEventListener('mousemove', (e) => {
      if (!dragging) return;
      if (Math.abs(e.clientX - dragSX) > 3 || Math.abs(e.clientY - dragSY) > 3) {
        justDragged = true;
      }
      panX = panSX + (e.clientX - dragSX);
      panY = panSY + (e.clientY - dragSY);
      clampPan();
      applyTransform(false);
    });

    document.addEventListener('mouseup', () => {
      if (!dragging) return;
      dragging = false;
      img.style.cursor = isOverflowing() ? 'grab' : 'zoom-in';
    });

    /* ================================================================
       Double-click → toggle between fit and 2.5×
       ================================================================ */
    img.addEventListener('dblclick', (e) => {
      if (!overlay.classList.contains('active')) return;
      e.preventDefault();

      if (zoom > 1.05) {
        resetView(true);
        return;
      }

      zoom = DBLCLICK_ZOOM;
      panX = 0;
      panY = 0;
      clampPan();
      applyTransform(true);
      updateCursor();
      showBadge();
    });

    /* ================================================================
       Touch: single-finger pan + two-finger pinch
       ================================================================ */
    let touches0 = null;
    let pinchDist0 = 0;
    let pinchZoom0 = 1;
    let pinchCX = 0, pinchCY = 0;    // midpoint at pinch start (overlay coords)
    let pinchPanX = 0, pinchPanY = 0; // pan at pinch start
    let suppressClickUntil = 0;

    stage.addEventListener('touchstart', (e) => {
      if (!overlay.classList.contains('active')) return;
      justDragged = false;
      if (e.touches.length === 1) {
        if (!isOverflowing()) return;
        touches0 = [e.touches[0]];
        pinchPanX = panX; pinchPanY = panY;
        e.preventDefault();
      } else if (e.touches.length === 2) {
        const [t0, t1] = [e.touches[0], e.touches[1]];
        touches0 = [t0, t1];
        pinchDist0 = Math.hypot(t1.clientX - t0.clientX, t1.clientY - t0.clientY);
        pinchZoom0 = zoom;
        pinchCX = (toOverlayX(t0.clientX) + toOverlayX(t1.clientX)) / 2;
        pinchCY = (toOverlayY(t0.clientY) + toOverlayY(t1.clientY)) / 2;
        pinchPanX = panX; pinchPanY = panY;
        e.preventDefault();
      }
    }, { passive: false });

    stage.addEventListener('touchmove', (e) => {
      if (!touches0) return;
      if (touches0.length === 1 && e.touches.length === 1) {
        const dx = e.touches[0].clientX - touches0[0].clientX;
        const dy = e.touches[0].clientY - touches0[0].clientY;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) justDragged = true;
        panX = pinchPanX + dx;
        panY = pinchPanY + dy;
        clampPan();
        applyTransform(false);
        e.preventDefault();
      } else if (touches0.length === 2 && e.touches.length === 2) {
        const [t0, t1] = [e.touches[0], e.touches[1]];
        const dist = Math.hypot(t1.clientX - t0.clientX, t1.clientY - t0.clientY);
        const cx   = (toOverlayX(t0.clientX) + toOverlayX(t1.clientX)) / 2;
        const cy   = (toOverlayY(t0.clientY) + toOverlayY(t1.clientY)) / 2;

        const oldZoom = zoom;
        zoom = clamp(pinchZoom0 * (dist / pinchDist0), MIN_ZOOM, MAX_ZOOM);
        if (Math.abs(zoom - oldZoom) > 0.005) justDragged = true;

        // Image-space fraction under starting pinch midpoint
        const ts0 = baseScale * pinchZoom0;
        const oldLeft0 = (vpW() - nw * ts0) / 2 + pinchPanX;
        const oldTop0  = (vpH() - nh * ts0) / 2 + pinchPanY;
        const fx = (pinchCX - oldLeft0) / (nw * ts0);
        const fy = (pinchCY - oldTop0)  / (nh * ts0);

        // Reposition so same image point follows current midpoint
        const newTs = baseScale * zoom;
        panX = cx - fx * nw * newTs - (vpW() - nw * newTs) / 2;
        panY = cy - fy * nh * newTs - (vpH() - nh * newTs) / 2;

        clampPan();
        applyTransform(false);
        updateCursor();
        showBadge();
        e.preventDefault();
      }
    }, { passive: false });

    function finishTouch(e) {
      if (justDragged) suppressClickUntil = performance.now() + 400;

      if (e.touches.length === 1 && isOverflowing()) {
        touches0 = [e.touches[0]];
        pinchPanX = panX;
        pinchPanY = panY;
        return;
      }

      touches0 = null;
      justDragged = false;
    }

    stage.addEventListener('touchend', finishTouch);
    stage.addEventListener('touchcancel', finishTouch);

    /* ================================================================
       Close triggers
       ================================================================ */
    overlay.addEventListener('click', (e) => {
      if (performance.now() < suppressClickUntil) return;
      if (justDragged) { justDragged = false; return; }
      if (e.target === overlay || e.target === stage) close();
    });

    closeButton.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('active')) close();
    });

    /* ================================================================
       Viewport resize (including mobile address-bar shows/hides)
       ================================================================ */
    function onViewportChange() {
      if (!overlay.classList.contains('active')) return;
      stage.style.left = `${vpOffX()}px`;
      stage.style.top = `${vpOffY()}px`;
      stage.style.width = `${vpW()}px`;
      stage.style.height = `${vpH()}px`;
      stage.style.right = 'auto';
      stage.style.bottom = 'auto';
      recalcBase();
      clampPan();
      applyTransform(false);
    }
    window.addEventListener('resize', onViewportChange);
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', onViewportChange);
      window.visualViewport.addEventListener('scroll', onViewportChange);
    }

    /* ================================================================
       Attach click-to-open on page images
       ================================================================ */
    function isInsideLink(el) {
      let p = el.parentElement;
      while (p && p !== document.body) {
        if (p.tagName === 'A') return true;
        p = p.parentElement;
      }
      return false;
    }

    function isSmallDecorative(el) {
      return (el.naturalWidth > 0 && el.naturalWidth < 200) ||
             (el.naturalHeight > 0 && el.naturalHeight < 200);
    }

    function attach(el) {
      if (el.dataset.zoomAttached) return;
      el.dataset.zoomAttached = '1';
      if (isInsideLink(el)) return;

      const tryAttach = () => {
        if (isSmallDecorative(el)) return;
        el.style.cursor = 'zoom-in';
        el.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          open(el.currentSrc || el.src, el.alt);
        });
      };

      if (el.complete) { tryAttach(); }
      else { el.addEventListener('load', tryAttach, { once: true }); }
    }

    document.querySelectorAll('.prose img').forEach(attach);
    const headerImg = document.querySelector('header img');
    if (headerImg) attach(headerImg);

    const article = document.querySelector('article');
    if (article) {
      new MutationObserver((mutations) => {
        for (const m of mutations) {
          for (const node of m.addedNodes) {
            if (node.nodeType === 1) {
              if (node.tagName === 'IMG') attach(node);
              node.querySelectorAll?.('img')?.forEach(attach);
            }
          }
        }
      }).observe(article, { childList: true, subtree: true });
    }
  })();
</script>
