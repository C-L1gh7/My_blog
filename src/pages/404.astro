---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar';
import { IconArrowRight } from '../components/Icons';
---

<BaseLayout
    title="404 - 页面未找到 | C_L1gh7's Blog"
    description="抱歉，您访问的页面不存在"
>
    <Navbar client:load />

    <main class="content-container py-12 min-h-[calc(100vh-80px)] flex items-center justify-center">
        <div class="max-w-2xl mx-auto text-center">
            {/* 404 标题 */}
            <div class="relative inline-block mb-8">
                <h1 class="text-[120px] md:text-[180px] font-black font-mono text-black leading-none -rotate-2 border-8 border-black px-8 py-4 bg-yellow-200 shadow-[12px_12px_0px_#000]">
                    404
                </h1>
            </div>

            {/* 错误信息 */}
            <div class="mb-8 border-4 border-black p-6 bg-white shadow-[6px_6px_0px_#000] rotate-1">
                <p class="text-xl md:text-2xl font-bold mb-2 font-mono uppercase">
                    页面走丢了
                </p>
                <p class="text-gray-600">
                    您访问的页面可能已被删除、重命名，或者从未存在过
                </p>
            </div>

            {/* 导航链接 */}
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a
                    href={import.meta.env.BASE_URL}
                    class="group inline-flex items-center gap-2 px-6 py-3 bg-black text-white font-mono font-bold border-4 border-black shadow-[4px_4px_0px_#ccc] hover:shadow-[6px_6px_0px_#999] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-all"
                >
                    返回首页
                    <IconArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
                </a>

                <a
                    href={import.meta.env.BASE_URL + "posts/"}
                    class="group inline-flex items-center gap-2 px-6 py-3 bg-white text-black font-mono font-bold border-4 border-black shadow-[4px_4px_0px_#ccc] hover:shadow-[6px_6px_0px_#999] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-all"
                >
                    浏览文章
                    <IconArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
                </a>
            </div>

            {/* 装饰元素 */}
            <div class="mt-12 flex justify-center gap-4">
                <div class="w-3 h-3 bg-black rotate-45 border-2 border-black"></div>
                <div class="w-3 h-3 bg-yellow-200 rotate-45 border-2 border-black"></div>
                <div class="w-3 h-3 bg-black rotate-45 border-2 border-black"></div>
            </div>
        </div>
    </main>
</BaseLayout>
