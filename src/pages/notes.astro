---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar';
import NoteCard from '../components/NoteCard.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const sortedNotes = notes.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const years = [...new Set(sortedNotes.map((note) => new Date(note.data.date).getFullYear()))];
const latestYear = years[0];

const title = "Personal Notes";
---

<BaseLayout
    title={title}
    description="袁焕予(C_L1gh7) 的学习笔记"
>
    <Navbar client:load />

    <main class="content-container pt-28 pb-20">
      <header class="border-b-2 border-black pb-6 md:pb-8">
        <div class="mb-4 flex items-center justify-between gap-4 font-mono text-[10px] font-bold uppercase text-gray-500 sm:text-xs">
          <span>Field notes / ongoing</span>
          <span>Archive No. {String(sortedNotes.length).padStart(2, '0')}</span>
        </div>

        <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(260px,0.55fr)] md:items-end">
          <div>
            <h1 class="text-3xl font-black uppercase leading-none sm:text-4xl md:text-5xl">Notes</h1>
            <p class="mt-4 max-w-2xl text-sm leading-6 text-gray-600 sm:text-base">
              尚未长成文章的想法、问题与灵感。简短记录，持续整理。
            </p>
          </div>

          <dl class="grid grid-cols-2 border-y border-black/20 font-mono md:border-y-0 md:border-l md:border-black/20">
            <div class="py-3 md:px-5 md:py-1">
              <dt class="text-[10px] font-bold uppercase text-gray-400">Entries</dt>
              <dd class="mt-1 text-lg font-black tabular-nums">{String(sortedNotes.length).padStart(2, '0')}</dd>
            </div>
            <div class="border-l border-black/20 py-3 pl-4 md:px-5 md:py-1">
              <dt class="text-[10px] font-bold uppercase text-gray-400">Latest</dt>
              <dd class="mt-1 text-lg font-black tabular-nums">{latestYear ?? '—'}</dd>
            </div>
          </dl>
        </div>
      </header>

      <section class="mt-8 md:mt-12" aria-labelledby="note-collection-title">
        <div class="mb-5 flex items-end justify-between border-b border-black/30 pb-3">
          <h2 id="note-collection-title" class="font-mono text-[10px] font-bold uppercase text-gray-500 sm:text-xs">Receipt roll</h2>
          <span class="font-mono text-[10px] font-bold uppercase text-gray-400">Latest issued first</span>
        </div>

        <div class="grid grid-cols-1 items-start gap-x-5 gap-y-9 md:grid-cols-2 lg:grid-cols-3">
        {sortedNotes.length > 0 ? (
            sortedNotes.map((note) => (
                <NoteCard note={note} />
            ))
        ) : (
            <div class="border border-dashed border-black/30 bg-white/40 px-5 py-16 text-center">
              <p class="font-mono text-sm text-gray-500">No notes filed yet.</p>
            </div>
        )}
        </div>
      </section>
    </main>
</BaseLayout>
